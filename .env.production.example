#==============================================================================
# CONTOH KONFIGURASI .env UNTUK PRODUCTION (Shared Hosting)
#------------------------------------------------------------------------------
# Salin file ini menjadi `.env` di server lalu isi nilai yang ditandai <...>.
# JANGAN commit file `.env` asli (sudah masuk .gitignore).
#
# Membuat kunci rahasia (jalankan di mesin mana pun yang punya PHP/OpenSSL):
#   - Encryption key : php spark key:generate   (mengisi encryption.key di .env)
#                      atau manual: openssl rand -hex 32  -> "hex2bin:<hasil>"
#   - JWT secret     : openssl rand -hex 32     (minimal 32 karakter)
#   - APP salt       : openssl rand -hex 16
#==============================================================================

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# WAJIB 'production' agar display_errors mati & error tidak bocor.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Sesuaikan dengan domain HTTPS Anda (akhiri dengan slash).
app.baseURL = 'https://domain-anda.com/'
# Paksa seluruh request lewat HTTPS + kirim header HSTS.
app.forceGlobalSecureRequests = true
app.indexPage = ''
# Zona waktu aplikasi.
app.appTimezone = 'Asia/Makassar'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = <nama_database>
database.default.username = <user_database>
database.default.password = <password_kuat_database>
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
# Pastikan false di produksi agar detail error SQL tidak bocor.
database.default.DBDebug = false

#--------------------------------------------------------------------
# ENCRYPTION  (dipakai App\Libraries\DataEncryption)
#--------------------------------------------------------------------
# Hasil dari `php spark key:generate` atau "hex2bin:" + openssl rand -hex 32.
encryption.key = <hex2bin:KUNCI_64_KARAKTER_HEX>

#--------------------------------------------------------------------
# JWT AUTHENTICATION  (dipakai App\Libraries\JwtLibrary)
#--------------------------------------------------------------------
# WAJIB minimal 32 karakter — JwtLibrary akan menolak (throw) bila lebih pendek.
JWT_SECRET_KEY = <RAHASIA_ACAK_MINIMAL_32_KARAKTER>
# Masa berlaku token (detik). Default 86400 (24 jam). Perpendek untuk keamanan
# lebih ketat (mis. 28800 = 8 jam). Logout mencabut token via blacklist jti.
JWT_EXPIRY = 86400

#--------------------------------------------------------------------
# RATE LIMIT (opsional — sesuaikan beban; default aman untuk kebanyakan kasus)
#--------------------------------------------------------------------
# Maks. percobaan login per menit per IP (anti brute-force).
RATELIMIT_LOGIN = 5
# Maks. submit survei per menit per IP. Longgar agar ramah kiosk/IP kantor
# bersama, namun mematikan flooding otomatis.
RATELIMIT_SURVEY = 30

#--------------------------------------------------------------------
# MONITORING ANOMALI (dashboard) + INTEGRASI ANTREAN PTSP
#--------------------------------------------------------------------
# Jam layanan untuk deteksi submit di luar jam (Senin-Jumat).
SERVICE_HOUR_START = 8
SERVICE_HOUR_END   = 16
# Ambang deteksi petugas outlier: tandai bila jumlah survei >= OUTLIER_MIN
# DAN jumlah > median * OUTLIER_FACTOR. OUTLIER_MIN mencegah false-positive
# saat volume kecil.
OUTLIER_MIN    = 10
OUTLIER_FACTOR = 3
# Integrasi ke sistem antrean PTSP (kosongkan untuk menonaktifkan —
# dashboard tetap jalan, sinyal "survei>dilayani" otomatis dinonaktifkan).
ANTRIAN_PTSP_URL     = https://antrian.example.com
ANTRIAN_PTSP_API_KEY = <shared-secret-sama-dengan-SURVEY_DASHBOARD_API_KEY-di-antrian-ptsp>
ANTRIAN_PTSP_TIMEOUT = 5

#--------------------------------------------------------------------
# ADMIN DEFAULT  (dipakai AdminSeeder saat `php spark db:seed`)
#--------------------------------------------------------------------
# Kredensial administrator awal. WAJIB diisi & diganti di produksi —
# jangan biarkan default. Seeder bersifat idempotent (tidak menimpa jika
# username sudah ada). Ubah password lewat panel/DB setelah login pertama.
ADMIN_DEFAULT_USERNAME = admin
ADMIN_DEFAULT_PASSWORD = <PASSWORD_ADMIN_KUAT>
ADMIN_DEFAULT_NAMA     = Administrator

#--------------------------------------------------------------------
# APP SALT  (dipakai DataEncryption::hash bila kelak dibutuhkan)
#--------------------------------------------------------------------
APP_SALT = <SALT_ACAK>

#--------------------------------------------------------------------
# CORS  (dipakai Config\Cors)
#--------------------------------------------------------------------
# Daftar origin yang diizinkan, pisahkan dengan koma. WAJIB diisi di produksi
# (default kosong = tidak ada origin lintas-domain yang diizinkan).
# Jika frontend disajikan satu domain dengan API (mode /app), boleh dikosongkan.
CORS_ALLOWED_ORIGINS = 'https://domain-anda.com'

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.cookieName = ci_session
session.expiration = 7200
# WAJIB true di produksi (cookie hanya dikirim via HTTPS).
session.cookieSecure = true
session.cookieHTTPOnly = true
session.cookieSameSite = 'Lax'

#--------------------------------------------------------------------
# SECURITY (CSRF cookie) — CSRF tidak aktif global (API JWT), namun
# bila kelak dipakai untuk form berbasis cookie, amankan cookienya.
#--------------------------------------------------------------------
security.cookieSecure = true

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 4 = hanya error & yang lebih kritis (hindari 9/verbose di produksi).
logger.threshold = 4
